// Compiled with TypeScript 4.7, the oldest version supported (`pnpm run test:ts-legacy`): checks that the
// built `.d.ts` parses and infers the converted keys. `moduleResolution` is left out on purpose:
// TypeScript 4.7 defaults to `node` for CommonJS, and TypeScript 6+ reports `node` as deprecated.
{
  "compilerOptions": {
    "target": "ES2015",
    "module": "CommonJS",
    "strict": true,
    "types": [],
    "noEmit": true
  },
  "include": ["index.ts"]
}
