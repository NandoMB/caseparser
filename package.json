{
  "name": "caseparser",
  "version": "5.0.0",
  "description": "Convert Strings/Arrays/Objects from a type of case to another one.",
  "author": "Fernando Machado Bernardino <fernandombernardino@gmail.com>",
  "homepage": "https://github.com/NandoMB/caseparser#readme",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "bugs": {
    "url": "https://github.com/NandoMB/caseparser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NandoMB/caseparser.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vitest --project node",
    "test": "vitest run --project node",
    "coverage": "vitest run --project node --coverage",
    "build": "tsdown",
    "lint": "tsc",
    "ci": "pnpm run lint && pnpm run test && pnpm run build",
    "release": "node scripts/release.js",
    "changeset:version": "changeset version && node scripts/sync-jsr-version.js",
    "test:browser": "vitest run --project browser",
    "test:examples": "node scripts/test-examples.js"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "playwright": "^1.63.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "caseparser",
    "case parser",
    "parser",
    "convert",
    "camel case",
    "snake case",
    "dash case",
    "kebab case",
    "constant case",
    "header case",
    "pascal case",
    "upper snake case",
    "upper dash case",
    "train case",
    "dot case",
    "title case",
    "sentence case",
    "camelCase",
    "snake_case",
    "dash-case",
    "kebab-case",
    "PascalCase",
    "UPPER_SNAKE_CASE",
    "UPPER-DASH-CASE",
    "Train-Case",
    "dot.case",
    "Title Case",
    "Sentence case"
  ]
}
