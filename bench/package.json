{
  "name": "caseparser-bench",
  "private": true,
  "type": "module",
  "description": "Benchmarks comparing caseparser with other case conversion libraries. Not published.",
  "scripts": {
    "all": "tsc -p . && vitest run --update && pnpm bench && pnpm memory && pnpm size",
    "test": "tsc -p . && vitest run",
    "bench": "vitest bench --run",
    "bench:bun": "bunx --bun vitest bench --run",
    "bench:deno": "deno run -A node_modules/vitest/vitest.mjs bench --run",
    "memory": "node memory/memory.ts",
    "size": "node size/size.ts"
  },
  "devDependencies": {
    "@types/humps": "2.0.6",
    "@types/lodash-es": "4.17.12",
    "camelcase-keys": "10.0.3",
    "case-anything": "3.1.6",
    "caseparser-5.1.0": "npm:caseparser@5.1.0",
    "change-case": "5.4.4",
    "es-toolkit": "1.52.0",
    "esbuild": "0.28.2",
    "humps": "2.0.1",
    "lodash-es": "4.18.1",
    "snakecase-keys": "9.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
